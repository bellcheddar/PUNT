      "why": "The pack's shortest click. A 50 ms blip under a finger."
    },
    "flip": {
      "from": "kenney_interface",
      "member": "Audio/switch_002.ogg",
      "gain_db": -6.0,
      "why": "A card turning over in the pack rip."
    },
    "horn_01": {
      "from": "freesound_528807",
      "gain_db": 0.0,
      "why": "A DJ airhorn. The sound an ordinary touchdown makes in a bar, and nothing an oscillator produces comes close."
    },
    "horn_02": {
      "from": "freesound_456966",
      "gain_db": 0.0,
      "why": "Trumpets. A real fanfare for a lead change, where the synthesised one was a lowpassed saw stack at 4.6% high-frequency energy."
    },
    "horn_03": {
      "from": "freesound_415504",
      "gain_db": 0.0,
      "why": "The full tadaa, held back for long touchdowns, clinches and hundred-point milestones."
    },
    "crowd": {
      "from": "freesound_333405",
      "gain_db": 0.0,
      "why": "An actual crowd. This is the one that could never have been synthesised: noise shaped like a cheer is not a cheer."
    },
    "trombone": {
      "from": "freesound_175409",
      "gain_db": 0.0,
      "why": "The wah-wah. Twenty-two thousand people have used this exact sound for exactly this joke."
    },
    "whoosh": {
      "from": "freesound_683096",
      "gain_db": 0.0,
      "why": "A real whoosh for a big play, with air in it rather than filtered white noise."
    },
    "riser": {
      "from": "freesound_649445",
      "gain_db": 0.0,
      "why": "Cinematic rise under the red-zone countdown, replacing the one that ended at 0.23 of full scale and popped."
    },
    "chime": {
      "from": "freesound_541985",
      "gain_db": 0.0,
      "why": "A success chime with actual partials. The synthesised one had three harmonics: a bare tone."
    },
    "rip": {
      "from": "freesound_181773",
      "gain_db": 0.0,
      "why": "Paper tearing, for the pack opening. The one sound where the synthesised version was already bright enough."
    },
    "doom": {
      "from": "freesound_199937",
      "gain_db": 0.0,
      "why": "A siren, for being mathematically finished. Dark by design, so this one stays under the 10% band on purpose."
    },
    "buzzer": {
      "from": "freesound_493163",
      "gain_db": 0.0,
      "why": "A wrong-answer buzzer for a goose egg from a starter."
    },
    "scratch": {
      "from": "freesound_151822",
      "gain_db": 0.0,
      "why": "A real vinyl scratch. Kenney's was brighter at 94% but synthetic; this is the record actually stopping."
    }
  },
  "_previews": "Freesound entries point at the HQ preview mp3, not the original wav. Only originals need OAuth2, and for stings that end up inside a 128 kbps sprite the preview is not the limiting factor -- the sprite's own encoding is."
}
