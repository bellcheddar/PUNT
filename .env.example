# PUNT configuration. Copy to .env and fill in. .env is gitignored and must stay
# that way: ESPN_S2 and ESPN_SWID are live session cookies for a real account.
#
# With NONE of this set, the app runs against the synthetic recording committed
# under data/recordings/ and says so in a banner on every page. That is the
# supported way to run a fresh clone.

# --- league -----------------------------------------------------------------
# LEAGUE_ID is the numeric id in the ESPN fantasy URL:
#   https://fantasy.espn.com/football/league?leagueId=123456789
LEAGUE_ID=
SEASON=2025

# --- authentication ---------------------------------------------------------
# Both cookies come from a browser logged into ESPN: devtools > Application >
# Cookies > espn.com. SWID includes its braces. They rotate every few months;
# when they do, the app keeps serving cached data and shows the commissioner a
# banner rather than breaking.
ESPN_S2=
ESPN_SWID=

# --- house rules ------------------------------------------------------------
# 0 safe, 1 teasing, 2 savage. Applies to the commentary phrase bank. The
# commissioner can lower it mid-season if the banter lands badly on a real person.
ROAST_LEVEL=1

# Seconds between upstream polls. 30 is the floor and is enforced in code:
# ten phones in a bar produce one upstream call regardless of this value.
POLL_SECONDS=30

# --- development ------------------------------------------------------------
# RECORD=1 writes every upstream response to data/recordings/<timestamp>/ so a
# live Sunday can be replayed on a Tuesday.
RECORD=0

# REPLAY names a directory under data/recordings/. REPLAY_SPEED is a multiplier:
# 60 replays a four-hour afternoon in four minutes.
REPLAY=
REPLAY_SPEED=1

# --- weekly recap -----------------------------------------------------------
RECAP_MODEL=qwen2.5-1.5b-instruct
RECAP_BACKEND=mlx

# --- audio sourcing (build time only, never needed to run PUNT) ---
# Read by tools/freesound.py to find CC0 stings. Apply at
# https://freesound.org/apiv2/apply/ -- log in first and go straight to that URL,
# there is no menu link. Leave the Callback URL blank: it is only for OAuth2.
# You want the API KEY, not the Client ID.
FREESOUND_TOKEN=

# --- deployment -------------------------------------------------------------
# Required for POST /admin/refresh-cookies. Unset means the route denies
# everything, which is the correct default for a public URL.
ADMIN_TOKEN=

# Read by deploy/deploy.sh and deploy/provision.sh.
# DROPLET_SSH is user@host, e.g. root@45.55.102.228.
DROPLET_SSH=
DROPLET_PATH=/opt/punt
SERVER_NAME=punt.mdeller.com
SSH_KEY=

# The app binds 127.0.0.1:8011 behind nginx. 8000-8010 belong to the other apps
# on the droplet; deploy/provision.sh refuses to install if something is already
# listening, and tests/test_deploy_config.py refuses if the number drifts apart
# across the three files that mention it.
BIND_ADDR=127.0.0.1:8011
