# Secrets. ESPN_S2 and SWID are session cookies for a real account: never committed.
.env
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# iCloud conflict copies. This repository lives under a synced Documents folder,
# and regenerating a recording in place while iCloud was mid-sync produced 99 of
# these -- "0002_mMatchupScore 2.json.gz" -- which reached a commit unnoticed
# because nothing ever reads them. `make_fixture.py --check` also fails on them.
* [0-9].json
* [0-9].json.gz
* [0-9].py
* [0-9].md
* [0-9].html
* [0-9].css

# Recorded upstream payloads captured from the live league. These contain real
# managers' display names and ESPN account GUIDs, so only the committed synthetic
# fixture under data/recordings/demo-* is ever tracked. See tools/make_fixture.py.
data/recordings/*/
!data/recordings/demo-*/

# Which Moments have already fired. Written every poll that produces one, read
# at startup so a restart mid-Sunday does not replay the afternoon. Derived, and
# specific to one deployment's league.
data/state/

# Downloaded CC0 source audio. Derived: data/audio_sources.json names every file
# and its sha256, tools/fetch_audio.py re-fetches them, and the built sprite is
# committed, so a fresh clone needs none of this.
data/audio_cache/

# The shortlist pages. Generated by tools/shortlist_audio.py and
# tools/shortlist_music.py, and they inline megabytes of candidate audio that
# was never chosen. Run the tool when you want to pick again.
docs/shortlist.html
docs/shortlist-music.html

# The audition page. Generated by tools/audition.py, and it inlines the whole
# sprite as base64 -- 300 kB of the same audio already committed one directory
# over, rewritten on every rebuild. Run the tool when you want to listen.
docs/audition.html

# Pre-synthesised TTS. Built at deploy time from data/phrases, never tracked:
# it is several hundred megabytes of derived audio.
static/audio/phrase/

# Exported session transcripts: /export writes them into the repo, and they are a
# verbatim record of a conversation rather than anything the project needs. The
# dated prefix is deliberate: a bare *.txt would quietly untrack requirements.txt.
[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-*.txt
*-this-session-is-being-continued-*.txt
.DS_Store
